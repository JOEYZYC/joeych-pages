---
import type { Locale } from "../i18n/locales"
import type { RouteId } from "../lib/routes"
import { getCorrespondingLocalePath } from "../lib/routes"
import { UI } from "../i18n/ui"
import Icon from "./Icon.astro"

type Props = { readonly routeId: RouteId; readonly locale: Locale }
const { routeId, locale } = Astro.props
const targetLocale = locale === "zh" ? "en" : "zh"
const labels = UI[locale].language
const counterpartPath = getCorrespondingLocalePath(routeId, locale)
---

<a
  class="language-link"
  href={counterpartPath}
  data-language-counterpart={counterpartPath}
  hreflang={targetLocale}
  title={locale === "zh" ? labels.switchToEnglish : labels.switchToChinese}
  aria-label={locale === "zh" ? labels.switchToEnglishVersion : labels.switchToChineseVersion}
>
  <Icon name="language" />
  <span lang={targetLocale === "zh" ? "zh-CN" : "en"}>{labels.label}</span>
  <span class="control-tooltip" data-control-tooltip aria-hidden="true">{locale === "zh" ? labels.switchToEnglish : labels.switchToChinese}</span>
</a>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(".language-link")
  for (const link of links) {
    const counterpartPath = link.dataset.languageCounterpart
    if (!counterpartPath) continue
    const synchronizeHref = () => {
      link.setAttribute("href", `${counterpartPath}${window.location.hash}`)
    }
    synchronizeHref()
    window.addEventListener("hashchange", synchronizeHref)
    window.addEventListener("profile:urlchange", synchronizeHref)
  }
</script>
