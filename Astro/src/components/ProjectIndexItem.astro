---
import type { Locale } from "../i18n/locales"
import type { Project } from "../content/schemas"
import RuledRecord from "./RuledRecord.astro"

type Props = { readonly project: Project; readonly locale: Locale; readonly number: number }
const { project, locale, number } = Astro.props
const ordinal = String(number).padStart(2, "0")
---

<RuledRecord meta={`${ordinal} / ${project.year}`}>
  <a class="project-index" href={`#${project.id}`} data-signal-target>
    <h3>{project.title[locale]} <span aria-hidden="true">→</span></h3>
    <p>{project.category[locale]}</p>
  </a>
</RuledRecord>
