---
import type { Locale } from "../../i18n/locales"
import { UI } from "../../i18n/ui"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getProfileData } from "../../lib/profile-data"
import { getRoutePath } from "../../lib/routes"
import { publicMediaUrl } from "../../lib/urls"
import "../../styles/home.css"
import Icon from "../Icon.astro"

type Props = { readonly locale: Locale }

const { locale } = Astro.props
const data = await getProfileData()
const { profile } = data
const labels = UI[locale]
---

<BaseLayout locale={locale} profile={profile} routeId="home">
  <div class="home-grid" data-home-grid>
    <section class="home-hero" data-home-hero aria-labelledby="page-title">
      <p class="eyebrow">{labels.routeIntros.home.overline}</p>
      <h1 id="page-title">{profile.name[locale]}</h1>
      <p class="home-role">{profile.role[locale]}</p>
      <p class="home-tagline">{profile.tagline[locale]}</p>
      <p class="home-summary">{profile.summary[locale]}</p>
      <div class="home-actions">
        <a class="home-action home-action--primary" href={getRoutePath("experience", locale)}>
          <span>{labels.actions.experience}</span>
          <span class="home-action-icon" aria-hidden="true"><Icon name="arrow-right" /></span>
        </a>
        <a class="home-action home-action--secondary" href={getRoutePath("projects", locale)}>
          <span>{labels.actions.projects}</span>
          <span class="home-action-icon" aria-hidden="true"><Icon name="arrow-right" /></span>
        </a>
      </div>
    </section>

    <figure class="home-portrait" data-home-portrait>
      <img
        src={publicMediaUrl(profile.portrait)}
        alt={profile.name[locale]}
        width="1320"
        height="2000"
      />
    </figure>

  </div>
</BaseLayout>
