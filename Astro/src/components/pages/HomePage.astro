---
import type { Locale } from "../../i18n/locales"
import { UI } from "../../i18n/ui"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getProfileData } from "../../lib/profile-data"
import { getRoutePath } from "../../lib/routes"
import { publicMediaUrl } from "../../lib/urls"
import "../../styles/home.css"
import "../../styles/projects.css"
import ProjectTile from "../ProjectTile.astro"

type Props = { readonly locale: Locale }

const { locale } = Astro.props
const data = await getProfileData()
const { profile } = data
const education = profile.education[0]
const featuredProjects = data.projects.filter(({ featured }) => featured)
const labels = UI[locale]
---

<BaseLayout locale={locale} profile={profile} routeId="home">
  <div class="home-grid" data-home-grid>
    <section class="home-hero" data-home-hero aria-labelledby="page-title">
      <p class="eyebrow">{labels.routeIntros.home.overline}</p>
      <h1 id="page-title">{profile.name[locale]}</h1>
      <p class="home-role">{profile.role[locale]}</p>
      <p class="home-tagline">{profile.tagline[locale]}</p>
      <p class="home-summary">{profile.summary[locale]}</p>
      <div class="home-actions">
        <a class="home-action home-action--primary" href={getRoutePath("experience", locale)}>
          {labels.actions.experience}
        </a>
        <a class="home-action home-action--secondary" href={getRoutePath("projects", locale)}>
          {labels.actions.projects}
        </a>
      </div>
    </section>

    <figure class="home-portrait" data-home-portrait>
      <img
        src={publicMediaUrl(profile.portrait)}
        alt={profile.name[locale]}
        width="1320"
        height="2000"
      />
    </figure>

    {profile.statistics.length > 0 && (
      <section
        class:list={["home-facts", { "home-facts--wide": education === undefined }]}
        data-home-facts
        aria-labelledby="home-facts-title"
      >
        <p class="eyebrow">{labels.sections.home.profile}</p>
        <h2 id="home-facts-title">{labels.sections.home.profile}</h2>
        <dl>
          {profile.statistics.map((statistic) => (
            <div>
              <dt>{statistic.label[locale]}</dt>
              <dd>{statistic.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {education && (
      <article
        id={`education-${education.id}`}
        class="home-education"
        data-home-education
        aria-labelledby="home-education-title"
      >
        <p class="eyebrow">{labels.routeIntros.experience.overline}</p>
        <h2 id="home-education-title">{labels.sections.home.education}</h2>
        <p class="home-education-period">{education.period}</p>
        <h3>{education.school[locale]}</h3>
        <p>{education.degree[locale]}</p>
        <ul>
          {education.highlights.map((highlight) => <li>{highlight[locale]}</li>)}
        </ul>
      </article>
    )}

    {featuredProjects.length > 0 && (
      <section class="home-featured" aria-labelledby="featured-title">
        <div class="home-featured-heading">
          <p class="eyebrow">{labels.routeIntros.projects.overline}</p>
          <h2 id="featured-title">{labels.sections.home.featured}</h2>
        </div>
        <div class="home-featured-grid">
          {featuredProjects.map((project, index) => (
            <ProjectTile locale={locale} number={index + 1} project={project} variant="featured" />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
