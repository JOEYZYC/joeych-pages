---
import type { Locale } from "../../i18n/locales"
import RuledRecord from "../RuledRecord.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { UI } from "../../i18n/ui"
import { getProfileData } from "../../lib/profile-data"
import { getRoutePath } from "../../lib/routes"
import { publicMediaUrl } from "../../lib/urls"
import "../../styles/home.css"

type Props = { readonly locale: Locale }

const { locale } = Astro.props
const data = await getProfileData()
const { profile } = data
const education = profile.education[0]
const featuredProjects = data.projects.filter(({ featured }) => featured)
---

<BaseLayout locale={locale} profile={profile} routeId="home">
  <section class="home-identity" aria-labelledby="page-title">
    <div class="home-identity-intro">
      <p class="eyebrow">{UI[locale].routeIntros.home.overline}</p>
      <h1 id="page-title">{profile.name[locale]}</h1>
      <p class="home-role">{profile.role[locale]}</p>
      <p class="home-tagline">{profile.tagline[locale]}</p>
      <p class="home-summary">{profile.summary[locale]}</p>
    </div>

    <figure class="home-portrait">
      <img
        src={publicMediaUrl(profile.portrait)}
        alt={profile.name[locale]}
        width="1320"
        height="2000"
      />
    </figure>

    <section class="home-profile" aria-label={UI[locale].sections.home.profile}>
      <p class="eyebrow">{UI[locale].sections.home.profile}</p>
      <dl class="profile-statistics">
        {profile.statistics.map((statistic) => (
          <div>
            <dt>{statistic.label[locale]}</dt>
            <dd>{statistic.value}</dd>
          </div>
        ))}
      </dl>
      <a class="experience-cta" href={getRoutePath("experience", locale)}>{UI[locale].navigation.experience}</a>
    </section>
  </section>

  {education && (
    <section class="editorial-section home-education" id={`education-${education.id}`} aria-labelledby="education-title">
      <p class="eyebrow">{UI[locale].routeIntros.experience.overline}</p>
      <h2 id="education-title" class="section-title">{UI[locale].sections.home.education}</h2>
      <RuledRecord meta={education.period}>
        <h3>{education.school[locale]}</h3>
        <p>{education.degree[locale]}</p>
        <ul>
          {education.highlights.map((highlight) => <li>{highlight[locale]}</li>)}
        </ul>
      </RuledRecord>
    </section>
  )}

  <section class="editorial-section home-featured" aria-labelledby="featured-title">
    <p class="eyebrow">{UI[locale].routeIntros.projects.overline}</p>
    <h2 id="featured-title" class="section-title">{UI[locale].sections.home.featured}</h2>
    <div class="featured-projects" data-signal-rail-group data-signal-rail-axis="vertical">
      <span class="signal-rail" data-signal-rail aria-hidden="true"></span>
      {featuredProjects.map((project, index) => (
        <RuledRecord meta={`${String(index + 1).padStart(2, "0")} / ${project.year}`}>
          <a href={`${getRoutePath("projects", locale)}#${project.id}`} data-signal-target>
            <h3>{project.title[locale]}</h3>
            <p>{project.category[locale]}</p>
          </a>
        </RuledRecord>
      ))}
    </div>
  </section>
</BaseLayout>
