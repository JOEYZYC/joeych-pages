---
import type { Locale } from "../../i18n/locales"
import { UI } from "../../i18n/ui"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getProfileData } from "../../lib/profile-data"
import { getRoutePath } from "../../lib/routes"
import { publicMediaUrl } from "../../lib/urls"
import "../../styles/home.css"
import Icon from "../Icon.astro"

type Props = { readonly locale: Locale }

const { locale } = Astro.props
const data = await getProfileData()
const { home, site } = data
const labels = UI[locale]
const heroBackgroundStyle = `--home-background-light: url("${publicMediaUrl(home.hero_background.light)}"); --home-background-dark: url("${publicMediaUrl(home.hero_background.dark)}")`
---

<BaseLayout locale={locale} page={home.page} site={site} routeId="home">
  <section class="home-hero" data-home-grid data-home-hero aria-labelledby="page-title">
    <div class="home-copy" data-home-copy>
      <h1 id="page-title">{home.heading[locale]}</h1>
      <p class="home-summary">{home.page.summary[locale]}</p>
      <div class="home-actions">
        <a class="home-action home-action--primary" href={getRoutePath("about", locale)}>
          <span>{labels.actions.about}</span>
          <span class="home-action-icon" aria-hidden="true"><Icon name="arrow-right" /></span>
        </a>
        <a class="home-action home-action--primary" href={getRoutePath("projects", locale)}>
          <span>{labels.actions.projects}</span>
          <span class="home-action-icon" aria-hidden="true"><Icon name="arrow-right" /></span>
        </a>
      </div>
    </div>

    <figure class="home-portrait" data-home-portrait>
      <img
        src={publicMediaUrl(home.portrait)}
        alt={site.name[locale]}
        width="1051"
        height="1497"
      />
    </figure>

    <span
      class="home-background"
      style={heroBackgroundStyle}
      aria-hidden="true"
    ></span>
  </section>
</BaseLayout>
