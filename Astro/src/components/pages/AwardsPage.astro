---
import type { Locale } from "../../i18n/locales"
import AchievementLedger from "../AchievementLedger.astro"
import EditorialIntro from "../EditorialIntro.astro"
import ResearchArchive from "../ResearchArchive.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { UI } from "../../i18n/ui"
import { getProfileData } from "../../lib/profile-data"
import "../../styles/achievements.css"

type Props = { readonly locale: Locale }
const { locale } = Astro.props
const data = await getProfileData()
const intro = UI[locale].routeIntros.awards
---

<BaseLayout locale={locale} profile={data.profile} routeId="awards">
  <EditorialIntro overline={intro.overline} title={intro.title} summary={intro.summary} />
  <AchievementLedger awards={data.awards} locale={locale} />
  <ResearchArchive locale={locale} publications={data.publications} patents={data.patents} thesis={data.thesis} />
</BaseLayout>
