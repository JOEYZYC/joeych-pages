---
import type { Locale } from "../../i18n/locales"
import { UI } from "../../i18n/ui"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getProfileData } from "../../lib/profile-data"
import "../../styles/experience.css"
import EditorialIntro from "../EditorialIntro.astro"
import Icon from "../Icon.astro"

type Props = { readonly locale: Locale }

const { locale } = Astro.props
const data = await getProfileData()
const { profile } = data
const labels = UI[locale]
---

<BaseLayout locale={locale} profile={profile} routeId="experience">
  <EditorialIntro
    overline={labels.routeIntros.experience.overline}
    title={labels.routeIntros.experience.title}
    summary={labels.routeIntros.experience.summary}
  />

  <section class="experience-section" aria-label={labels.routeIntros.experience.title}>
    <div class="experience-grid">
      {profile.education.length > 0 && (
        <header class="experience-heading" data-experience-heading>
          <p class="eyebrow">{labels.routeIntros.experience.overline}</p>
          <h2>
            <span class="experience-heading-icon" aria-hidden="true"><Icon name="graduation-cap" /></span>
            {labels.sections.experience.education}
          </h2>
        </header>
      )}
      {profile.education.map((education) => (
        <article
          id={`education-${education.id}`}
          class="experience-panel experience-panel--education"
          data-experience-record
          data-experience-kind="education"
        >
          <p class="experience-period">{education.period}</p>
          <h3>{education.school[locale]}</h3>
          <p class="experience-role">{education.degree[locale]}</p>
          <ul>
            {education.highlights.map((highlight) => <li>{highlight[locale]}</li>)}
          </ul>
        </article>
      ))}

      {profile.campus_experience.length > 0 && (
        <header class="experience-heading experience-heading--campus" data-experience-heading>
          <p class="eyebrow">{labels.routeIntros.experience.overline}</p>
          <h2>{labels.sections.experience.campus}</h2>
        </header>
      )}
      {profile.campus_experience.map((experience, index) => (
        <article
          id={`campus-${experience.id}`}
          class="experience-panel experience-panel--campus"
          data-experience-record
          data-experience-kind="campus"
          data-experience-position={index + 1}
        >
          <p class="experience-period">{experience.period}</p>
          <h3>{experience.organization[locale]}</h3>
          <p class="experience-role">{experience.role[locale]}</p>
          <ul>
            {experience.details.map((detail) => <li>{detail[locale]}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
