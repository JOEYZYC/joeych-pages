---
import type { Locale } from "../../i18n/locales"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getProfileData } from "../../lib/profile-data"
import "../../styles/skills.css"

type Props = { readonly locale: Locale }
const { locale } = Astro.props
const data = await getProfileData()
---

<BaseLayout locale={locale} page={data.techStack.page} site={data.site} routeId="tech-stack">
  <section class="capability-tree" aria-labelledby="capability-tree-title" data-capability-tree>
    <h1 id="capability-tree-title" class="visually-hidden">{data.techStack.page.title[locale]}</h1>
    <p class="capability-tree-label">{data.techStack.map.title[locale]}</p>
    <ul class="capability-tree-branches">
      {data.techStack.skills.map((group) => <li class="capability-tree-subtree" data-capability-branch={group.id}>
        <section aria-label={group.title[locale]}>
          <ul class="capability-tree-leaves">
            {group.tags.map((tag) => <li>
              <article class="capability-tree-leaf" data-capability-leaf={tag.id}>
                <h2>{tag[locale]}</h2>
                <p>{tag.description[locale]}</p>
              </article>
            </li>)}
          </ul>
          <p class="capability-tree-branch-node">{group.title[locale]}</p>
        </section>
      </li>)}
    </ul>
    <span class="capability-tree-junction" aria-hidden="true"></span>
    <p class="capability-tree-root">{data.techStack.map.center[locale]}</p>
  </section>
</BaseLayout>
