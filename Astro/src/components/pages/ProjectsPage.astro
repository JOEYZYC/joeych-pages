---
import type { Locale } from "../../i18n/locales"
import { UI } from "../../i18n/ui"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getProfileData } from "../../lib/profile-data"
import "../../styles/projects.css"
import EditorialIntro from "../EditorialIntro.astro"
import ProjectExplorer from "../ProjectExplorer.astro"
import ProjectRecord from "../ProjectRecord.astro"

type Props = { readonly locale: Locale }

const { locale } = Astro.props
const data = await getProfileData()
const labels = UI[locale]
---

<BaseLayout locale={locale} profile={data.profile} routeId="projects">
  <div data-projects-page>
    <EditorialIntro
      overline={labels.routeIntros.projects.overline}
      title={labels.routeIntros.projects.title}
      summary={data.profile.summary[locale]}
    />

    <ProjectExplorer locale={locale} projects={data.projects} skills={data.profile.skills} />

    {data.projects.length > 0 && (
      <>
        <header class="project-details-heading">
          <div class="project-navigator-shell" data-project-navigator-shell hidden>
            <label for="project-navigator">{labels.projectExplorer.navigator}</label>
            <select id="project-navigator" data-project-navigator></select>
          </div>
          <h2 id="project-details-title">{labels.projectExplorer.details}</h2>
        </header>
        <section class="project-records" aria-labelledby="project-details-title">
          {data.projects.map((project, index) => (
            <ProjectRecord project={project} locale={locale} number={index + 1} />
          ))}
        </section>
      </>
    )}
  </div>
</BaseLayout>
