---
import type { Certificate } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import { getDialogIds } from "../lib/dialog-ids"
import { publicMediaUrl } from "../lib/urls"
import Icon from "./Icon.astro"

type Props = { readonly certificates: readonly Certificate[]; readonly id: string; readonly locale: Locale }
const { certificates, id, locale } = Astro.props
const labels = UI[locale].certificate
const ids = getDialogIds(id)
const first = certificates[0]
---

{first && (
  <div data-certificate-dialog-root>
    <a class="certificate-control certificate-fallback" data-certificate-fallback href={publicMediaUrl(first.src)}>
      <Icon name="certificate" />
      <span>{labels.view}</span>
    </a>
    <button
      id={ids.trigger}
      type="button"
      class="certificate-control"
      data-certificate-trigger
      aria-haspopup="dialog"
      aria-controls={ids.dialog}
      hidden
    >
      <Icon name="certificate" />
      <span>{labels.view}</span>
    </button>
    <dialog id={ids.dialog} class="dialog-surface certificate-dialog" data-certificate-dialog aria-labelledby={ids.title} hidden>
      <button
        class="dialog-close"
        type="button"
        data-certificate-close
        aria-label={labels.close}
        title={labels.close}
      ><Icon name="xmark" /></button>
      <h2 id={ids.title} tabindex="-1">{labels.title}</h2>
      <p class="certificate-status" data-certificate-loading>{labels.loading}</p>
      <img
        class="certificate-image"
        data-certificate-image
        src={publicMediaUrl(first.src)}
        alt={first[locale]}
        loading="lazy"
      />
      <p class="certificate-caption" data-certificate-caption>{first[locale]}</p>
      <p class="certificate-status" data-certificate-unavailable hidden>{labels.unavailable}</p>
      <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-certificate-announcement>{labels.loading}</p>
      <ol hidden data-certificate-items>
        {certificates.map((certificate) => (
          <li data-source={publicMediaUrl(certificate.src)} data-label={certificate[locale]}></li>
        ))}
      </ol>
      {certificates.length > 1 && (
        <div class="certificate-actions">
          <button
            type="button"
            class="certificate-control"
            data-certificate-previous
            aria-label={labels.previous}
            title={labels.previous}
            disabled
          >
            <Icon name="chevron-left" />
            <span>{labels.previous}</span>
          </button>
          <button
            type="button"
            class="certificate-control"
            data-certificate-next
            aria-label={labels.next}
            title={labels.next}
          >
            <span>{labels.next}</span>
            <Icon name="chevron-right" />
          </button>
        </div>
      )}
    </dialog>
  </div>
)}

<script>
  import { attachDialogDismissal } from "../lib/dialog-dismissal"

  const initializeCertificateDialogs = () => {
    const certificateRoots = document.querySelectorAll<HTMLElement>("[data-certificate-dialog-root]")
    for (const root of certificateRoots) {
    if (root.dataset.certificateReady === "true") continue
    const fallback = root.querySelector<HTMLAnchorElement>("[data-certificate-fallback]")
    const trigger = root.querySelector<HTMLButtonElement>("[data-certificate-trigger]")
    const dialog = root.querySelector<HTMLDialogElement>("[data-certificate-dialog]")
    const title = dialog?.querySelector<HTMLElement>("h2")
    const close = dialog?.querySelector<HTMLButtonElement>("[data-certificate-close]")
    const image = dialog?.querySelector<HTMLImageElement>("[data-certificate-image]")
    const caption = dialog?.querySelector<HTMLElement>("[data-certificate-caption]")
    const loading = dialog?.querySelector<HTMLElement>("[data-certificate-loading]")
    const unavailable = dialog?.querySelector<HTMLElement>("[data-certificate-unavailable]")
    const announcement = dialog?.querySelector<HTMLElement>("[data-certificate-announcement]")
    const previous = dialog?.querySelector<HTMLButtonElement>("[data-certificate-previous]")
    const next = dialog?.querySelector<HTMLButtonElement>("[data-certificate-next]")
    const items = dialog?.querySelectorAll<HTMLElement>("[data-certificate-items] li")
    if (!fallback || !trigger || !dialog || !title || !close || !image || !caption || !loading || !unavailable || !announcement || !items?.length) continue

    let index = 0
    const showLoading = () => {
      loading.hidden = false
      unavailable.hidden = true
      image.hidden = false
      announcement.textContent = loading.textContent
    }
    const showLoaded = () => {
      loading.hidden = true
      unavailable.hidden = true
      image.hidden = false
      announcement.textContent = caption.textContent
    }
    const showUnavailable = () => {
      loading.hidden = true
      unavailable.hidden = false
      image.hidden = true
      announcement.textContent = unavailable.textContent
    }
    const settleImage = () => {
      if (!image.complete) return
      if (image.naturalWidth > 0) showLoaded()
      else showUnavailable()
    }
    const update = () => {
      const certificate = items.item(index)
      const source = certificate?.dataset.source
      const label = certificate?.dataset.label
      if (!source || !label) return
      showLoading()
      image.src = source
      image.alt = label
      caption.textContent = label
      if (previous) previous.disabled = index === 0
      if (next) next.disabled = index === items.length - 1
      queueMicrotask(settleImage)
    }

    trigger.addEventListener("click", () => {
      update()
      dialog.showModal()
      title.focus({ preventScroll: true })
    })
    close.addEventListener("click", () => dialog.close())
    previous?.addEventListener("click", () => {
      index = Math.max(0, index - 1)
      update()
    })
    next?.addEventListener("click", () => {
      index = Math.min(items.length - 1, index + 1)
      update()
    })
    image.addEventListener("load", showLoaded)
    image.addEventListener("error", showUnavailable)
    attachDialogDismissal(dialog, () => trigger.focus())

    root.dataset.certificateReady = "true"
    update()
    dialog.hidden = false
    trigger.hidden = false
      fallback.hidden = true
    }
  }
  initializeCertificateDialogs()
  document.addEventListener("profile:content-mounted", initializeCertificateDialogs)
</script>
