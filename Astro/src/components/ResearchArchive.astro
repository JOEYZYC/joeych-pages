---
import type { Patent, Publication, Thesis } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import CertificateDialog from "./CertificateDialog.astro"
import RuledRecord from "./RuledRecord.astro"

type Props = {
  readonly locale: Locale
  readonly patents: readonly Patent[]
  readonly publications: readonly Publication[]
  readonly thesis: Thesis
}
const { locale, patents, publications, thesis } = Astro.props
---

<section class="editorial-section research-archive" aria-label={UI[locale].routeIntros.awards.title}>
  <p class="eyebrow">RESEARCH ARCHIVE</p>
  {publications.length > 0 && <section aria-labelledby="publications-title">
    <h2 id="publications-title" class="section-title">{UI[locale].sections.awards.publications}</h2>
    {publications.map((publication) => <RuledRecord meta={String(publication.year)}>
      <div data-research-id={publication.id} data-research-kind="publication">
        <h3>{publication.title[locale]}</h3>
        <p class="record-detail">{publication.venue[locale]} · {publication.authors[locale]}</p>
        <ul class="tag-list" aria-label={publication.title[locale]}>{publication.tags.map((tag) => <li>{tag}</li>)}</ul>
        {publication.links.map((link) => link.url === null ? <span class="unavailable-link">{UI[locale].unavailable.link}</span> : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
        {publication.certificates.length > 0 && <CertificateDialog certificates={publication.certificates} id={`awards-publication-${publication.id}`} locale={locale} />}
      </div>
    </RuledRecord>)}
  </section>}
  {patents.length > 0 && <section class="research-section" aria-labelledby="patents-title">
    <h2 id="patents-title" class="section-title">{UI[locale].sections.awards.patents}</h2>
    {patents.map((patent) => <RuledRecord meta={String(patent.year)}>
      <div data-research-id={patent.id} data-research-kind="patent">
        <h3>{patent.title[locale]}</h3>
        <p class="record-detail">{patent.authors[locale]}</p>
        <ul class="tag-list" aria-label={patent.title[locale]}>{patent.tags.map((tag) => <li>{tag}</li>)}</ul>
        {patent.links.map((link) => link.url === null ? <span class="unavailable-link">{UI[locale].unavailable.link}</span> : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
        {patent.certificates.length > 0 && <CertificateDialog certificates={patent.certificates} id={`awards-patent-${patent.id}`} locale={locale} />}
      </div>
    </RuledRecord>)}
  </section>}
  <section class="research-section" aria-labelledby="thesis-title">
    <h2 id="thesis-title" class="section-title">{UI[locale].sections.awards.thesis}</h2>
    <RuledRecord meta={String(thesis.year)}>
      <div data-research-id={thesis.id} data-research-kind="thesis">
        <h3>{thesis.title[locale]}</h3>
        <p class="record-detail">{thesis.award[locale]}</p>
        <ul class="tag-list" aria-label={thesis.title[locale]}>{thesis.tags.map((tag) => <li>{tag}</li>)}</ul>
        {thesis.links.map((link) => link.url === null ? <span class="unavailable-link">{UI[locale].unavailable.link}</span> : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
      </div>
    </RuledRecord>
  </section>
</section>
