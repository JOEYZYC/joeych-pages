---
import type { Patent, Publication, Thesis } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import CertificateDialog from "./CertificateDialog.astro"

type Props = {
  readonly locale: Locale
  readonly patents: readonly Patent[]
  readonly publications: readonly Publication[]
  readonly thesis: Thesis
}
const { locale, patents, publications, thesis } = Astro.props
const labels = UI[locale]
---

<section class="research-archive" aria-label={labels.routeIntros.awards.title}>
  <header class="archive-heading">
    <p class="eyebrow">{labels.sections.awards.researchOverline}</p>
  </header>

  {publications.length > 0 && (
    <section class="research-section" aria-labelledby="publications-title">
      <h2 id="publications-title">{labels.sections.awards.publications}</h2>
      <div class="research-grid">
        {publications.map((publication) => (
          <article
            class="research-panel"
            data-research-id={publication.id}
            data-research-kind="publication"
          >
            <p class="research-year">{publication.year}</p>
            <h3>{publication.title[locale]}</h3>
            <p class="record-detail">{publication.venue[locale]} · {publication.authors[locale]}</p>
            {publication.tags.length > 0 && (
              <ul class="tag-list" aria-label={publication.title[locale]}>
                {publication.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
            {publication.links.map((link) => link.url === null
              ? <span class="unavailable-link">{link.label[locale]} — {labels.unavailable.link}</span>
              : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
            {publication.certificates.length > 0 && (
              <CertificateDialog
                certificates={publication.certificates}
                id={`awards-publication-${publication.id}`}
                locale={locale}
              />
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  {patents.length > 0 && (
    <section class="research-section" aria-labelledby="patents-title">
      <h2 id="patents-title">{labels.sections.awards.patents}</h2>
      <div class="research-grid">
        {patents.map((patent) => (
          <article
            class="research-panel"
            data-research-id={patent.id}
            data-research-kind="patent"
          >
            <p class="research-year">{patent.year}</p>
            <h3>{patent.title[locale]}</h3>
            <p class="record-detail">{patent.authors[locale]}</p>
            {patent.tags.length > 0 && (
              <ul class="tag-list" aria-label={patent.title[locale]}>
                {patent.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
            {patent.links.map((link) => link.url === null
              ? <span class="unavailable-link">{link.label[locale]} — {labels.unavailable.link}</span>
              : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
            {patent.certificates.length > 0 && (
              <CertificateDialog
                certificates={patent.certificates}
                id={`awards-patent-${patent.id}`}
                locale={locale}
              />
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="research-section" aria-labelledby="thesis-title">
    <h2 id="thesis-title">{labels.sections.awards.thesis}</h2>
    <div class="research-grid">
      <article
        class="research-panel research-panel--thesis"
        data-research-id={thesis.id}
        data-research-kind="thesis"
      >
        <p class="research-year">{thesis.year}</p>
        <h3>{thesis.title[locale]}</h3>
        <p class="record-detail">{thesis.award[locale]}</p>
        {thesis.tags.length > 0 && (
          <ul class="tag-list" aria-label={thesis.title[locale]}>
            {thesis.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
        {thesis.links.map((link) => link.url === null
          ? <span class="unavailable-link">{link.label[locale]} — {labels.unavailable.link}</span>
          : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
      </article>
    </div>
  </section>
</section>
