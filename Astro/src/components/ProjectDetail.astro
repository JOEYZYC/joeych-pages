---
import type { Project } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import type { RelatedAchievement } from "../lib/related-achievements"
import { getRoutePath } from "../lib/routes"
import { publicMediaUrl } from "../lib/urls"
import ProjectMedia from "./ProjectMedia.astro"

type Props = {
  readonly idPrefix: string
  readonly locale: Locale
  readonly mode: "dialog" | "record"
  readonly number: number
  readonly project: Project
  readonly relatedAchievements: readonly RelatedAchievement[]
}

const { idPrefix, locale, mode, number, project, relatedAchievements } = Astro.props
const labels = UI[locale]
const ordinal = String(number).padStart(2, "0")
const remainingFigures = project.figures.filter((figure) => figure.src !== project.image)
const titleId = `${idPrefix}-title`
---

<header class="project-record-header">
  <div class="project-record-meta">
    <span>{ordinal} / {project.year}</span>
    <span>{project.category[locale]}</span>
  </div>
  <div class="project-record-states">
    <span class="project-state project-current-state" data-project-current-label>{labels.projectExplorer.current}</span>
    <span class="project-state project-origin-state" data-project-origin-label data-origin-prefix={labels.projectExplorer.skillOrigin}></span>
  </div>
  <h2
    id={titleId}
    data-project-dialog-title={mode === "dialog" ? true : undefined}
    data-project-record-title={mode === "record" ? true : undefined}
    tabindex="-1"
  >{project.title[locale]}</h2>
  <p class="project-record-claim">{project.claim[locale]}</p>
</header>

{project.image === null ? (
  <div
    class="project-media project-media--record project-media--unavailable"
    data-project-media
    data-project-media-context="record"
    data-project-media-kind="unavailable"
    role="img"
    aria-label={labels.projectExplorer.imagePendingAlt}
  >
    <div class="project-media-well">
      <p class="project-media-pending">{labels.projectExplorer.imagePending}</p>
    </div>
  </div>
) : <ProjectMedia context="record" locale={locale} project={project} loading="lazy" />}

<div class="project-record-body">
  <p class="project-record-summary">{project.summary[locale]}</p>
  <ul class="project-tag-list" aria-label={project.title[locale]}>
    {project.tags.map((tag) => <li>{tag[locale]}</li>)}
  </ul>

  <section class="project-record-section project-related-achievements" aria-labelledby={`${idPrefix}-achievements`}>
    <h3 id={`${idPrefix}-achievements`}>{labels.sections.projects.achievements}</h3>
    {relatedAchievements.length > 0 ? (
      <div class="project-related-achievement-grid">
        {relatedAchievements.map((achievement) => {
          const record = achievement.record
          const archiveId = `${achievement.kind}-${record.id}`
          const certificates = record.certificates
          return <article class="project-related-achievement" data-related-achievement-id={record.id} data-related-achievement-kind={achievement.kind}>
            <p class="project-related-achievement-kind">
              {achievement.kind === "award" ? labels.sections.awards.awards : labels.sections.awards.publications}
            </p>
            <h4>{record.title[locale]}</h4>
            {achievement.kind === "award"
              ? <p class="project-related-achievement-detail">{record.prizes.map((prize) => prize[locale]).join(" / ")}</p>
              : <p class="project-related-achievement-detail">{record.venue[locale]} · {record.authors[locale]}</p>}
            <a class="project-related-achievement-link" href={`${getRoutePath("awards", locale)}#${archiveId}`}>
              {labels.sections.projects.archive}
            </a>
            {certificates.length > 0 && (
              <div class="project-related-certificate-grid">
                {certificates.map((certificate) => (
                  <figure>
                    <a href={publicMediaUrl(certificate.src)} target="_blank" rel="noopener noreferrer">
                      <img src={publicMediaUrl(certificate.src)} alt={certificate[locale]} loading="lazy" />
                    </a>
                    <figcaption>{certificate[locale]}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </article>
        })}
      </div>
    ) : <p class="project-template-unavailable">{labels.projectExplorer.pending}</p>}
  </section>

  <section class="project-record-section project-record-contribution" aria-labelledby={`${idPrefix}-contribution`}>
    <h3 id={`${idPrefix}-contribution`}>{labels.sections.projects.contribution}</h3>
    <p class:list={{ "project-template-unavailable": project.contribution[locale] === labels.projectExplorer.pending }}>{project.contribution[locale]}</p>
  </section>

  {remainingFigures.length > 0 && (
    <section class="project-record-section project-figures" aria-labelledby={`${idPrefix}-figures`}>
      <h3 id={`${idPrefix}-figures`}>{labels.sections.projects.figures}</h3>
      <div class="project-figure-grid">
        {remainingFigures.map((figure) => {
          if (figure.src === undefined) {
            return <figure class="project-figure-unavailable"><figcaption>{figure[locale]}</figcaption><p>{labels.unavailable.media}</p></figure>
          }
          return <figure>
            <img src={publicMediaUrl(figure.src)} alt={figure[locale]} loading="lazy" decoding="async" />
            <figcaption>{figure[locale]}</figcaption>
          </figure>
        })}
      </div>
    </section>
  )}

  {project.links.length > 0 && (
    <section class="project-record-section project-links" aria-labelledby={`${idPrefix}-links`}>
      <h3 id={`${idPrefix}-links`}>{labels.sections.projects.links}</h3>
      <ul>
        {project.links.map((link) => <li>{link.url === null
          ? <span class="project-link-unavailable" data-project-link-unavailable>{link.label[locale]} — {labels.unavailable.link}</span>
          : <a href={link.url} target="_blank" rel="noopener noreferrer"><span data-project-link-marker aria-hidden="true">{labels.links.external}</span>{link.label[locale]}</a>}</li>)}
      </ul>
    </section>
  )}
</div>
