---
import type { Project } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import { publicMediaUrl } from "../lib/urls"
import CertificateDialog from "./CertificateDialog.astro"
import ProjectMedia from "./ProjectMedia.astro"

type Props = {
  readonly idPrefix: string
  readonly locale: Locale
  readonly mode: "dialog" | "record"
  readonly project: Project
}

const { idPrefix, locale, mode, project } = Astro.props
const labels = UI[locale]
const remainingFigures = project.figures.filter((figure) => figure.src !== project.image)
const availableFigures = project.figures.filter((figure) => figure.src !== undefined)
const titleId = `${idPrefix}-title`
---

<header class="project-record-header">
  <div class="project-record-meta">
    <span>{project.year}</span>
    <span>{project.category[locale]}</span>
  </div>
  <div class="project-record-states">
    <span class="project-state project-current-state" data-project-current-label>{labels.projectExplorer.current}</span>
    <span class="project-state project-origin-state" data-project-origin-label data-origin-prefix={labels.projectExplorer.skillOrigin}></span>
  </div>
  <h2
    id={titleId}
    data-project-dialog-title={mode === "dialog" ? true : undefined}
    data-project-record-title={mode === "record" ? true : undefined}
    tabindex="-1"
  >{project.title[locale]}</h2>
  <p class="project-record-claim">{project.claim[locale]}</p>
</header>

{project.image === null ? (
  <div class="project-media project-media--record project-media--unavailable" data-project-media data-project-media-context="record" data-project-media-kind="unavailable" role="img" aria-label={labels.projectExplorer.imagePendingAlt}>
    <div class="project-media-well"><p class="project-media-pending">{labels.projectExplorer.imagePending}</p></div>
  </div>
) : <ProjectMedia context="record" locale={locale} record={project} loading="lazy" showCaption={mode === "record"} />}

{mode === "dialog" && availableFigures.length > 0 && (
  <div class="project-figure-controls" role="group" aria-label={labels.sections.projects.figures} data-project-figure-controls>
    {availableFigures.map((figure) => <button
      class="project-figure-control"
      type="button"
      data-project-figure-select
      data-project-figure-src={publicMediaUrl(figure.src)}
      data-project-figure-source={figure.src}
      data-project-figure-caption={figure[locale]}
      aria-pressed={figure.src === project.image ? "true" : "false"}
    >{figure[locale]}</button>)}
  </div>
)}

<div class="project-record-body">
  <p class="project-record-summary">{project.summary[locale]}</p>
  <ul class="project-tag-list" aria-label={project.title[locale]}>
    {project.tags.map((tag) => <li>{tag[locale]}</li>)}
  </ul>

  {project.awards.length > 0 && (
    <section class="project-record-section project-outcomes" aria-labelledby={`${idPrefix}-awards`}>
      <h3 id={`${idPrefix}-awards`}>{labels.sections.awards.awards}</h3>
      <div class="project-outcome-grid">
        {project.awards.map((award) => <article class="project-outcome" data-project-outcome-kind="award" data-project-outcome-id={award.id}>
          <h4>{award.title[locale]}</h4>
          <p>{award.prizes.map((prize) => prize[locale]).join(" / ")}</p>
          {award.certificates.length > 0 && <CertificateDialog certificates={award.certificates} id={`${idPrefix}-award-${award.id}`} locale={locale} />}
        </article>)}
      </div>
    </section>
  )}

  {project.publications.length > 0 && (
    <section class="project-record-section project-outcomes" aria-labelledby={`${idPrefix}-publications`}>
      <h3 id={`${idPrefix}-publications`}>{labels.sections.awards.publications}</h3>
      <div class="project-outcome-grid">
        {project.publications.map((publication) => <article class="project-outcome" data-project-outcome-kind="publication" data-project-outcome-id={publication.id}>
          <h4>{publication.title[locale]}</h4>
          <p>{publication.venue[locale]} · {publication.authors[locale]}</p>
          {publication.certificates.length > 0 && <CertificateDialog certificates={publication.certificates} id={`${idPrefix}-publication-${publication.id}`} locale={locale} />}
        </article>)}
      </div>
    </section>
  )}

  {project.patents.length > 0 && (
    <section class="project-record-section project-outcomes" aria-labelledby={`${idPrefix}-patents`}>
      <h3 id={`${idPrefix}-patents`}>{labels.sections.awards.patents}</h3>
      <div class="project-outcome-grid">
        {project.patents.map((patent) => <article class="project-outcome" data-project-outcome-kind="patent" data-project-outcome-id={patent.id}>
          <h4>{patent.title[locale]}</h4>
          <p>{patent.authors[locale]}</p>
          {patent.certificates.length > 0 && <CertificateDialog certificates={patent.certificates} id={`${idPrefix}-patent-${patent.id}`} locale={locale} />}
        </article>)}
      </div>
    </section>
  )}

  <section class="project-record-section project-record-contribution" aria-labelledby={`${idPrefix}-contribution`}>
    <h3 id={`${idPrefix}-contribution`}>{labels.sections.projects.contribution}</h3>
    <p class:list={{ "project-template-unavailable": project.contribution[locale] === labels.projectExplorer.pending }}>{project.contribution[locale]}</p>
  </section>

  {mode === "record" && remainingFigures.length > 0 && (
    <section class="project-record-section project-figures" aria-labelledby={`${idPrefix}-figures`}>
      <h3 id={`${idPrefix}-figures`}>{labels.sections.projects.figures}</h3>
      <div class="project-figure-grid">
        {remainingFigures.map((figure) => figure.src === undefined
          ? <figure class="project-figure-unavailable"><figcaption>{figure[locale]}</figcaption><p>{labels.unavailable.media}</p></figure>
          : <figure><img src={publicMediaUrl(figure.src)} alt={figure[locale]} loading="lazy" decoding="async" /><figcaption>{figure[locale]}</figcaption></figure>)}
      </div>
    </section>
  )}

  {project.links.length > 0 && (
    <section class="project-record-section project-links" aria-labelledby={`${idPrefix}-links`}>
      <h3 id={`${idPrefix}-links`}>{labels.sections.projects.links}</h3>
      <ul>{project.links.map((link) => <li>{link.url === null
        ? <span class="project-link-unavailable" data-project-link-unavailable>{link.label[locale]} — {labels.unavailable.link}</span>
        : <a href={link.url} target="_blank" rel="noopener noreferrer"><span data-project-link-marker aria-hidden="true">{labels.links.external}</span>{link.label[locale]}</a>}</li>)}</ul>
    </section>
  )}
</div>
