---
import type { Project } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import ProjectMedia from "./ProjectMedia.astro"

type Props = {
  readonly locale: Locale
  readonly project: Project
}

const { locale, project } = Astro.props
const labels = UI[locale]
const outcomeLabels = [
  project.awards.length > 0 ? `${labels.sections.awards.awards} ${project.awards.length}` : "",
  project.publications.length > 0 ? `${labels.sections.awards.publications} ${project.publications.length}` : "",
  project.patents.length > 0 ? `${labels.sections.awards.patents} ${project.patents.length}` : "",
].filter(Boolean)
const honorKeys = [
  ...project.awards.map(({ id }) => `award:${id}`),
  ...project.publications.map(({ id }) => `publication:${id}`),
  ...project.patents.map(({ id }) => `patent:${id}`),
]
---

<a
  class:list={["project-card", { "project-card--text": project.image === null }]}
  href={`#${project.id}`}
  data-project-card
  data-project-id={project.id}
  data-project-tags={JSON.stringify(project.tags.map((tag) => tag.en))}
  data-project-honors={JSON.stringify(honorKeys)}
  aria-controls="project-detail-dialog"
  aria-haspopup="dialog"
  hidden
>
  <div class="project-card-body">
    <p class="project-card-meta"><span>{project.year}</span><span>{project.category[locale]}</span></p>
    <h2>{project.title[locale]}</h2>
    <p class="project-card-claim">{project.claim[locale]}</p>
    {project.contribution[locale] !== labels.projectExplorer.pending && <p class="project-card-contribution"><strong>{labels.portfolio.contribution}</strong> {project.contribution[locale]}</p>}
    <ul class="project-tag-list project-card-tags">
      {project.tags.slice(0, 3).map((tag) => <li>{tag[locale]}</li>)}
    </ul>
    {outcomeLabels.length > 0 && <p class="project-card-achievements">{outcomeLabels.join(" · ")}</p>}
    {project.awards[0] && <p class="project-card-award">{project.awards[0].prizes.map((prize) => prize[locale]).join(" / ")}</p>}
    {project.image === null && <span class="project-media-pending" data-project-media data-project-media-context="card" data-project-media-kind="unavailable">{labels.projectExplorer.imagePending}</span>}
    <span class="project-card-open">{labels.projectExplorer.open}</span>
  </div>
  {project.image !== null && <ProjectMedia context="card" locale={locale} record={project} loading="lazy" />}
</a>
