---
import type { Award, Profile, Project, Publication } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import { resolveRelatedAchievements } from "../lib/related-achievements"
import ProjectCard from "./ProjectCard.astro"
import ProjectDetail from "./ProjectDetail.astro"
import ProjectDialog from "./ProjectDialog.astro"
import ProjectRecord from "./ProjectRecord.astro"

type Props = {
  readonly awards: readonly Award[]
  readonly locale: Locale
  readonly projects: readonly Project[]
  readonly publications: readonly Publication[]
  readonly skills: Profile["skills"]
}

const { awards, locale, projects, publications, skills } = Astro.props
const labels = UI[locale]
const categories: { value: string; label: string }[] = []
const seenCategories = new Set<string>()
const relatedByProject = new Map(projects.map((project) => [
  project.id,
  resolveRelatedAchievements(project, awards, publications),
]))
const honors = [...new Map(
  projects.flatMap((project) => (relatedByProject.get(project.id) ?? [])
    .filter((achievement) => achievement.kind === "award")
    .map((achievement) => [achievement.record.id, achievement.record.title[locale]]),
  ),
).entries()].map(([value, label]) => ({ value, label }))

for (const project of projects) {
  if (seenCategories.has(project.category.en)) continue
  seenCategories.add(project.category.en)
  categories.push({ value: project.category.en, label: project.category[locale] })
}

const skillEvidence = Object.fromEntries(
  skills.flatMap((group) => group.tags).map((tag) => [
    tag.id,
    {
      label: tag[locale],
      projectIds: [...new Set(tag.evidence.flatMap((evidence) =>
        evidence.type === "project" ? [evidence.project_id] : []
      ))],
    },
  ]),
)
const serializedSkillEvidence = JSON.stringify(skillEvidence).replaceAll("<", "\\u003c")
---

{projects.length === 0 ? (
  <p class="project-empty-source" data-project-source-empty>{labels.projectExplorer.emptySource}</p>
) : (
  <div class="project-explorer" data-project-explorer>
    <div class="project-filter-bar" data-project-filter-controls hidden>
      <label class="project-filter-field" for="project-category-filter">
        <span>{labels.projectExplorer.category}</span>
        <select id="project-category-filter" data-project-category-filter>
          <option value="">{labels.projectExplorer.allCategories}</option>
          {categories.map((category) => <option value={category.value}>{category.label}</option>)}
        </select>
      </label>
      <label class="project-filter-field" for="project-name-filter">
        <span>{labels.projectExplorer.name}</span>
        <select id="project-name-filter" data-project-name-filter data-all-projects-label={labels.projectExplorer.allProjects}>
          <option value="">{labels.projectExplorer.allProjects}</option>
        </select>
      </label>
      <label class="project-filter-field" for="project-honor-filter">
        <span>{labels.projectExplorer.honor}</span>
        <select id="project-honor-filter" data-project-honor-filter>
          <option value="">{labels.projectExplorer.allHonors}</option>
          {honors.map((honor) => <option value={honor.value}>{honor.label}</option>)}
        </select>
      </label>
    </div>

    <div class="project-card-grid" data-project-card-grid hidden>
      {projects.map((project, index) => (
        <ProjectCard locale={locale} number={index + 1} project={project} relatedAchievements={relatedByProject.get(project.id) ?? []} />
      ))}
    </div>

    <ProjectDialog locale={locale} />
    {projects.map((project, index) => (
      <template data-project-dialog-template data-project-id={project.id}>
        <ProjectDetail idPrefix={`project-dialog-${project.id}`} locale={locale} mode="dialog" number={index + 1} project={project} relatedAchievements={relatedByProject.get(project.id) ?? []} />
      </template>
    ))}

    <script type="application/json" data-project-skill-evidence set:html={serializedSkillEvidence}></script>

    <section class="project-records" data-project-records>
      {projects.map((project, index) => (
        <ProjectRecord locale={locale} number={index + 1} project={project} relatedAchievements={relatedByProject.get(project.id) ?? []} />
      ))}
    </section>
  </div>
)}

<script>
  type Evidence = { readonly label: string; readonly projectIds: readonly string[] }
  type EvidenceMap = Record<string, Evidence>

  const isEvidenceMap = (value: unknown): value is EvidenceMap => {
    if (value === null || typeof value !== "object" || Array.isArray(value)) return false
    return Object.values(value).every((entry) => (
      entry !== null && typeof entry === "object" && !Array.isArray(entry) &&
      "label" in entry && typeof entry.label === "string" &&
      "projectIds" in entry && Array.isArray(entry.projectIds) &&
      entry.projectIds.every((projectId) => typeof projectId === "string")
    ))
  }

  for (const explorer of document.querySelectorAll<HTMLElement>("[data-project-explorer]")) {
    if (explorer.dataset.explorerReady === "true") continue
    const controls = explorer.querySelector<HTMLElement>("[data-project-filter-controls]")
    const cardGrid = explorer.querySelector<HTMLElement>("[data-project-card-grid]")
    const categoryFilter = explorer.querySelector<HTMLSelectElement>("[data-project-category-filter]")
    const nameFilter = explorer.querySelector<HTMLSelectElement>("[data-project-name-filter]")
    const honorFilter = explorer.querySelector<HTMLSelectElement>("[data-project-honor-filter]")
    const cards = [...explorer.querySelectorAll<HTMLElement>("[data-project-card]")]
    const records = [...explorer.querySelectorAll<HTMLElement>("[data-project-record]")]
    const dialog = explorer.querySelector<HTMLDialogElement>("[data-project-dialog]")
    const dialogContent = explorer.querySelector<HTMLElement>("[data-project-dialog-content]")
    const dialogTemplates = new Map([...explorer.querySelectorAll<HTMLTemplateElement>("[data-project-dialog-template]")].map((template) => [template.dataset.projectId ?? "", template]))
    const recordsSection = explorer.querySelector<HTMLElement>("[data-project-records]")
    const evidenceSource = explorer.querySelector<HTMLScriptElement>("[data-project-skill-evidence]")
    if (!controls || !cardGrid || !categoryFilter || !nameFilter || !honorFilter || cards.length === 0 || records.length === 0 || !dialog || !dialogContent || dialogTemplates.size !== cards.length || !recordsSection || !evidenceSource) continue

    let evidenceMap: EvidenceMap
    try {
      const parsed: unknown = JSON.parse(evidenceSource.textContent ?? "")
      if (!isEvidenceMap(parsed)) continue
      evidenceMap = parsed
    } catch (error) {
      if (error instanceof SyntaxError) continue
      throw error
    }

    const cardById = new Map(cards.map((card) => [card.dataset.projectId ?? "", card]))
    const recordById = new Map(records.map((record) => [record.id, record]))
    const projectIds = cards.map((card) => card.dataset.projectId).filter((id): id is string => Boolean(id))
    const allProjectsLabel = nameFilter.dataset.allProjectsLabel ?? ""
    let trigger: HTMLElement | undefined
    let visibleIds = [...projectIds]

    const currentHashId = () => {
      if (window.location.hash.length < 2) return ""
      try {
        return decodeURIComponent(window.location.hash.slice(1))
      } catch {
        return window.location.hash.slice(1)
      }
    }

    const replaceUrl = (url: URL) => {
      window.history.replaceState(window.history.state, "", `${url.pathname}${url.search}${url.hash}`)
    }

    const clearActiveState = () => {
      for (const record of records) record.dataset.active = "false"
      dialog.dataset.active = "false"
    }

    const setActiveProject = (id: string) => {
      clearActiveState()
      recordById.get(id)?.setAttribute("data-active", "true")
      dialog.dataset.active = "true"
    }

    const categoryIds = () => projectIds.filter((id) => {
      const card = cardById.get(id)
      return categoryFilter.value === "" || card?.dataset.projectCategory === categoryFilter.value
    })

    const rebuildNameFilter = (reset = false) => {
      const previous = nameFilter.value
      const ids = categoryIds()
      nameFilter.replaceChildren(new Option(allProjectsLabel, ""))
      for (const id of ids) {
        const record = recordById.get(id)
        const ordinal = record?.dataset.projectOrdinal
        const title = record?.dataset.projectTitle
        if (!ordinal || !title) continue
        nameFilter.add(new Option(`${ordinal} — ${title}`, id))
      }
      nameFilter.value = !reset && ids.includes(previous) ? previous : ""
    }

    const clearSkillOrigin = (removeQuery: boolean) => {
      for (const element of [...cards, ...records, dialog]) {
        delete element.dataset.evidenceOrigin
        const message = element.querySelector<HTMLElement>("[data-project-origin-label]")
        if (message) message.textContent = ""
      }
      if (!removeQuery) return
      const url = new URL(window.location.href)
      if (!url.searchParams.has("skill")) return
      url.searchParams.delete("skill")
      replaceUrl(url)
    }

    const applySkillOrigin = () => {
      clearSkillOrigin(false)
      const url = new URL(window.location.href)
      const skillId = url.searchParams.get("skill")
      const projectId = currentHashId()
      const evidence = skillId === null ? undefined : evidenceMap[skillId]
      if (!skillId || !projectId || !evidence?.projectIds.includes(projectId)) {
        if (skillId) {
          url.searchParams.delete("skill")
          replaceUrl(url)
        }
        return
      }
      for (const element of [cardById.get(projectId), recordById.get(projectId), dialog]) {
        if (!element) continue
        element.dataset.evidenceOrigin = "true"
        const message = element.querySelector<HTMLElement>("[data-project-origin-label]")
        const prefix = message?.dataset.originPrefix
        if (message && prefix) message.textContent = `${prefix}: ${evidence.label}`
      }
    }

    const applyFilters = ({ clearOrigin = true } = {}) => {
      if (clearOrigin) clearSkillOrigin(true)
      const category = categoryFilter.value
      const name = nameFilter.value
      const honor = honorFilter.value
      visibleIds = projectIds.filter((id) => {
        const card = cardById.get(id)
        const matchesHonor = honor === "" || card?.dataset.projectHonors?.split(" ").includes(honor)
        return (category === "" || card?.dataset.projectCategory === category) && (name === "" || id === name) && matchesHonor
      })
      const visible = new Set(visibleIds)
      for (const id of projectIds) {
        const card = cardById.get(id)
        if (card) card.hidden = !visible.has(id)
      }
      const hashId = currentHashId()
      if (hashId && !visible.has(hashId)) {
        const url = new URL(window.location.href)
        url.hash = ""
        replaceUrl(url)
      }
      if (name) setActiveProject(name)
      else clearActiveState()
    }

    const openDialog = (id: string, nextTrigger?: HTMLElement, focusTitle = true) => {
      const template = dialogTemplates.get(id)
      if (!template) return
      dialogContent.replaceChildren(template.content.cloneNode(true))
      dialog.dataset.projectId = id
      const title = dialogContent.querySelector<HTMLElement>("[data-project-dialog-title]")
      if (!title) return
      dialog.setAttribute("aria-labelledby", title.id)
      if (nextTrigger) trigger = nextTrigger
      if (!dialog.open) dialog.showModal()
      if (focusTitle) title.focus({ preventScroll: true })
    }

    const revealProject = (id: string, focusTitle: boolean) => {
      const card = cardById.get(id)
      if (!card) return
      const category = card.dataset.projectCategory
      if (category) categoryFilter.value = category
      rebuildNameFilter()
      nameFilter.value = id
      honorFilter.value = ""
      applyFilters({ clearOrigin: false })
      setActiveProject(id)
      openDialog(id, undefined, focusTitle)
      applySkillOrigin()
    }

    for (const card of cards) {
      card.addEventListener("click", (event) => {
        event.preventDefault()
        const id = card.dataset.projectId
        if (!id) return
        setActiveProject(id)
        openDialog(id, card)
      })
    }
    const close = dialog.querySelector<HTMLButtonElement>("[data-project-dialog-close]")
    close?.addEventListener("click", () => dialog.close())
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return
      const bounds = dialog.getBoundingClientRect()
      const outside = event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom
      if (outside) dialog.close()
    })
    dialog.addEventListener("close", () => trigger?.focus())
    dialog.hidden = false
    categoryFilter.addEventListener("change", () => {
      honorFilter.value = ""
      rebuildNameFilter(true)
      applyFilters()
    })
    nameFilter.addEventListener("change", () => {
      honorFilter.value = ""
      applyFilters()
    })
    honorFilter.addEventListener("change", () => {
      categoryFilter.value = ""
      rebuildNameFilter(true)
      applyFilters()
    })
    window.addEventListener("hashchange", () => {
      const id = currentHashId()
      if (cardById.has(id)) revealProject(id, true)
      else applySkillOrigin()
    })

    rebuildNameFilter()
    cardGrid.hidden = false
    controls.hidden = false
    recordsSection.hidden = true
    explorer.dataset.explorerReady = "true"
    const initialHash = currentHashId()
    if (cardById.has(initialHash)) revealProject(initialHash, false)
    else {
      applyFilters({ clearOrigin: false })
      applySkillOrigin()
    }
  }
</script>
