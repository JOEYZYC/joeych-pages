---
import type { Site } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import type { RouteId } from "../lib/routes"
import { getCorrespondingLocalePath, getRoutePath, ROUTE_IDS } from "../lib/routes"

type Props = { readonly locale: Locale; readonly site: Site; readonly routeId: RouteId }
const { locale, site, routeId } = Astro.props
const labels = UI[locale]
const counterpart = getCorrespondingLocalePath(routeId, locale)
const targetLanguage = locale === "zh" ? labels.language.switchToEnglish : labels.language.switchToChinese
const contacts = [
  { label: labels.contact.email, href: `mailto:${site.contact.email}`, value: site.contact.email },
  { label: labels.contact.github, href: site.contact.github, value: site.contact.github },
  { label: labels.contact.scholar, href: site.contact.scholar, value: site.contact.scholar },
  { label: labels.contact.orcid, href: site.contact.orcid, value: site.contact.orcid },
] as const
---

<div class="noscript-header-fallback" data-noscript-header-fallback>
  <nav data-noscript-header-routes aria-label={labels.mainNavigation}>
    {ROUTE_IDS.map((id) => (
      <a href={getRoutePath(id, locale)} aria-current={id === routeId ? "page" : undefined}>{labels.navigation[id]}</a>
    ))}
  </nav>
  <a data-noscript-language-counterpart href={counterpart}>{targetLanguage}</a>
  <ul data-noscript-contact-links>
    {contacts.map((contact) => (
      <li><a href={contact.href}>{contact.label}: {contact.value}</a></li>
    ))}
  </ul>
</div>
