---
import type { Site } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import type { RouteId } from "../lib/routes"
import { getRoutePath, ROUTE_IDS } from "../lib/routes"
import ContactDialog from "./ContactDialog.astro"
import LanguageLink from "./LanguageLink.astro"
import ThemeToggle from "./ThemeToggle.astro"
import NoScriptHeaderFallback from "./NoScriptHeaderFallback.astro"
import Icon from "./Icon.astro"

type Props = { readonly locale: Locale; readonly site: Site; readonly routeId: RouteId }
const { locale, site, routeId } = Astro.props
const labels = UI[locale]
---
<header class="site-directory" data-site-header>
  {routeId !== "home" && <a class="reader-return" data-overview-return href={getRoutePath("home", locale)}>← {labels.navigation.home}</a>}
  <details class="directory" data-directory>
    <summary aria-label={labels.menuOpen} data-menu-toggle aria-expanded="false">{labels.menu}<span class="header-icon" aria-hidden="true"><Icon name="bars" /></span></summary>
    <div class="directory-panel">
      <a class="directory-name" href={getRoutePath("home", locale)}>{site.name[locale]}</a>
      <nav aria-label={labels.mainNavigation} id="primary-navigation" data-header-navigation>
        {ROUTE_IDS.map((id, index) => <a href={getRoutePath(id, locale)} aria-current={id === routeId ? "page" : undefined} data-header-route><span aria-hidden="true">0{index + 1}</span>{labels.navigation[id]}<span aria-hidden="true">↗</span></a>)}
      </nav>
      <div class="directory-actions"><LanguageLink routeId={routeId} locale={locale} /><ThemeToggle locale={locale} /><ContactDialog id="site-contact" locale={locale} site={site} /></div>
    </div>
  </details>
</header>
<noscript><NoScriptHeaderFallback locale={locale} site={site} routeId={routeId} /></noscript>
<script>
  for (const directory of document.querySelectorAll<HTMLDetailsElement>("[data-directory]")) {
    const summary = directory.querySelector("summary")
    directory.addEventListener("toggle", () => {
      summary?.setAttribute("aria-expanded", String(directory.open))
      if (directory.open && document.activeElement === summary) directory.querySelector<HTMLElement>("[data-header-route]")?.focus()
    })
    for (const link of directory.querySelectorAll("[data-header-route]")) link.addEventListener("click", () => { directory.open = false })
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !directory.open || document.querySelector("dialog[open]")) return
      directory.open = false
      summary?.focus()
    })
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !directory.contains(event.target)) directory.open = false
    })
  }
</script>
