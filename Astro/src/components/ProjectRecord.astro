---
import type { Project } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import type { RelatedAchievement } from "../lib/related-achievements"
import ProjectDetail from "./ProjectDetail.astro"

type Props = {
  readonly locale: Locale
  readonly number: number
  readonly project: Project
  readonly relatedAchievements: readonly RelatedAchievement[]
}

const { locale, number, project, relatedAchievements } = Astro.props
---

<article
  id={project.id}
  class="project-record"
  data-project-record
  data-project-id={project.id}
  data-project-category={project.category.en}
  data-project-title={project.title[locale]}
  data-project-ordinal={String(number).padStart(2, "0")}
  data-active="false"
>
  <ProjectDetail idPrefix={project.id} locale={locale} mode="record" number={number} project={project} relatedAchievements={relatedAchievements} />
</article>
