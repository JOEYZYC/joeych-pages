---
import type { Profile } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"

type Props = { readonly locale: Locale; readonly profile: Profile }
const { locale, profile } = Astro.props
const links = [
  { label: UI[locale].links.github, href: profile.contact.github },
  { label: UI[locale].links.scholar, href: profile.contact.scholar },
  { label: UI[locale].links.orcid, href: profile.contact.orcid },
] as const
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-contact">
      <p class="footer-label">{UI[locale].contact.email}</p>
      <a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
    </div>
    <nav class="footer-destinations" aria-label={UI[locale].links.related}>
      <p class="footer-label">{UI[locale].links.related}</p>
      <ul class="footer-links">
        {links.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>
