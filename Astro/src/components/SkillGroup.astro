---
import type { Profile, Project } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import { getRoutePath } from "../lib/routes"
import Icon from "./Icon.astro"

type Props = {
  readonly group: Profile["skills"][number]
  readonly locale: Locale
  readonly projectTitles: ReadonlyMap<Project["id"], string>
}
const { group, locale, projectTitles } = Astro.props
---

<section class="skill-group" data-skill-group={group.id} aria-labelledby={group.id}>
  <h2 id={group.id} class="section-title">
    <span class="skill-group-heading"><Icon name="microchip" /><span>{group.title[locale]}</span></span>
  </h2>
  {group.tags.map((tag) => {
    const tagTitleId = `${tag.id}-title`
    const evidenceTitleId = `${tag.id}-evidence`
    return <article class="skill-tag" data-skill-tag={tag.id} aria-labelledby={tagTitleId}>
      <h3 id={tagTitleId}>{tag[locale]}</h3>
      <ul class="skill-components">
        {tag.components.map((component) => <li data-skill-component={component.id}><code>{component.id}</code></li>)}
      </ul>
      <section class="skill-evidence" aria-labelledby={evidenceTitleId}>
        <h4 id={evidenceTitleId}>{UI[locale].sections["tech-stack"].evidence}</h4>
        <ul>
          {tag.evidence.map((evidence) => {
            const supports = evidence.supports.join(" ")
            switch (evidence.type) {
              case "project": {
                const projectTitle = projectTitles.get(evidence.project_id)
                if (projectTitle === undefined) {
                  throw new Error(`Missing project title for skill evidence: ${evidence.project_id}`)
                }
                return <li
                  class="skill-evidence-row"
                  data-skill-evidence="project"
                  data-project-id={evidence.project_id}
                  data-supports={supports}
                >
                  <div class="skill-evidence-reference">
                    <span class="skill-evidence-type"><Icon name="link" /><span>{UI[locale].evidence.project}</span></span>
                    <a href={`${getRoutePath("projects", locale)}?skill=${encodeURIComponent(tag.id)}#${evidence.project_id}`}>
                      {projectTitle}
                    </a>
                  </div>
                  <span class="skill-evidence-supports">{evidence.supports.join(", ")}</span>
                </li>
              }
              case "credential":
                return <li class="skill-evidence-row" data-skill-evidence="credential" data-supports={supports}>
                  <div class="skill-evidence-reference">
                    <span class="skill-evidence-type"><Icon name="file-lines" /><span>{UI[locale].evidence.credential}</span></span>
                  </div>
                  <span class="skill-evidence-supports">{evidence.supports.join(", ")}</span>
                </li>
              case "general-ability":
                return <li
                  class="skill-evidence-row"
                  data-skill-evidence="general-ability"
                  data-evidence-level={evidence.level}
                  data-supports={supports}
                >
                  <div class="skill-evidence-reference">
                    <span class="skill-evidence-type"><Icon name="file-lines" /><span>{UI[locale].evidence.generalAbility}</span></span>
                    <span class="skill-evidence-level">{UI[locale].evidence.levels[evidence.level]}</span>
                  </div>
                  <span class="skill-evidence-supports">{evidence.supports.join(", ")}</span>
                </li>
            }
          })}
        </ul>
      </section>
    </article>
  })}
</section>
