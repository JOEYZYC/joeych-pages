---
import type { Award } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import CertificateDialog from "./CertificateDialog.astro"
import RuledRecord from "./RuledRecord.astro"

type Props = { readonly awards: readonly Award[]; readonly locale: Locale }
const { awards, locale } = Astro.props
const years = [...new Set(awards.map((award) => award.year))]

function isTopTierPrize(prize: Award["prizes"][number]): boolean {
  return prize.zh.includes("一等") || prize.en.includes("First")
}
---

{awards.length > 0 && <section class="editorial-section achievement-ledger" aria-labelledby="awards-title">
  <p class="eyebrow">ACHIEVEMENT LEDGER</p>
  <h2 id="awards-title" class="section-title">{UI[locale].sections.awards.awards}</h2>
  {years.map((year) => <section class="achievement-year" aria-labelledby={`awards-${year}`}>
    <h3 id={`awards-${year}`} class="year-heading">{year}</h3>
    {awards.filter((award) => award.year === year).map((award) => <RuledRecord meta={String(award.year)}>
      <div data-award-id={award.id}>
        <h3>{award.title[locale]}</h3>
        <p class="record-detail">
          {award.prizes.map((prize) => <span class:list={["award-prize", { "award-prize--top-tier": isTopTierPrize(prize) }]}>{prize[locale]}</span>)}
        </p>
        {award.tags.length > 0 && <ul class="tag-list" aria-label={award.title[locale]}>{award.tags.map((tag) => <li>{tag}</li>)}</ul>}
        {award.links.map((link) => link.url === null ? <span class="unavailable-link">{UI[locale].unavailable.link}</span> : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
        {award.certificates.length > 0 && <CertificateDialog certificates={award.certificates} id={`awards-award-${award.id}`} locale={locale} />}
      </div>
    </RuledRecord>)}
  </section>)}
</section>}
