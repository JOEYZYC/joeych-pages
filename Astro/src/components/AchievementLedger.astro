---
import type { Award } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import { UI } from "../i18n/ui"
import CertificateDialog from "./CertificateDialog.astro"
import Icon from "./Icon.astro"

type Props = { readonly awards: readonly Award[]; readonly locale: Locale }
const { awards, locale } = Astro.props
const labels = UI[locale]
const years = [...new Set(awards.map((award) => award.year))]
---

{awards.length > 0 && (
  <section class="achievement-ledger" aria-labelledby="awards-title">
    <header class="archive-heading archive-heading--awards">
      <p class="eyebrow">{labels.sections.awards.ledgerOverline}</p>
      <div class="archive-heading-title">
        <span class="section-icon" aria-hidden="true"><Icon name="trophy" /></span>
        <h2 id="awards-title">{labels.sections.awards.awards}</h2>
      </div>
    </header>
    {years.map((year) => (
      <section class="achievement-year" aria-labelledby={`awards-${year}`}>
        <h3 id={`awards-${year}`} class="year-heading">{year}</h3>
        <div class="achievement-grid">
          {awards.filter((award) => award.year === year).map((award) => (
            <article
              id={`award-${award.id}`}
              class="award-panel"
              data-award-id={award.id}
              data-award-featured={String(award.featured)}
            >
              <p class="award-year">{award.year}</p>
              <h4>{award.title[locale]}</h4>
              <p class="award-prizes">
                {award.prizes.map((prize) => <span class="award-prize">{prize[locale]}</span>)}
              </p>
              {award.tags.length > 0 && (
                <ul class="tag-list" aria-label={award.title[locale]}>
                  {award.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
              {award.links.map((link) => link.url === null
                ? <span class="unavailable-link">{link.label[locale]} — {labels.unavailable.link}</span>
                : <a class="archive-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label[locale]}</a>)}
              {award.certificates.length > 0 && (
                <CertificateDialog
                  certificates={award.certificates}
                  id={`awards-award-${award.id}`}
                  locale={locale}
                />
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
)}
