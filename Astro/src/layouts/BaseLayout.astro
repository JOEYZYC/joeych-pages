---
import { Font } from "astro:assets"
import type { Locale } from "../i18n/locales"
import type { RouteId } from "../lib/routes"
import type { Profile } from "../content/schemas"
import { getPageMeta } from "../lib/page-meta"
import "../styles/fonts.css"
import "../styles/base.css"
import "../styles/layout.css"
import "../styles/components.css"
import SeoHead from "../components/SeoHead.astro"
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"

type Props = {
  readonly locale: Locale
  readonly profile: Profile
  readonly routeId: RouteId
  readonly noindex?: boolean
}
const { locale, profile, routeId, noindex = false } = Astro.props
const { title, description } = getPageMeta({ locale, profile, routeId })
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"} data-js="false">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const root = document.documentElement
        root.dataset.js = "true"
        let theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        let hasThemeOverride = false
        try {
          const storedTheme = window.localStorage.getItem("joeych-theme")
          if (storedTheme === "light" || storedTheme === "dark") {
            theme = storedTheme
            hasThemeOverride = true
          }
        } catch {}
        root.dataset.themeOverride = String(hasThemeOverride)
        root.dataset.theme = theme
        root.style.colorScheme = theme
      })()
    </script>
    <Font cssVariable="--font-google-sans-code" preload />
    <SeoHead routeId={routeId} locale={locale} profile={profile} title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <SiteHeader locale={locale} profile={profile} routeId={routeId} />
    <main class="site-main"><slot /></main>
    <SiteFooter locale={locale} profile={profile} />
  </body>
</html>
