---
import { Font } from "astro:assets"
import type { PageMeta, Site } from "../content/schemas"
import type { Locale } from "../i18n/locales"
import type { RouteId } from "../lib/routes"
import { UI } from "../i18n/ui"
import "../styles/fonts.css"
import "../styles/base.css"
import "../styles/layout.css"
import "../styles/components.css"
import SeoHead from "../components/SeoHead.astro"
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"

type Props = {
  readonly locale: Locale
  readonly page: PageMeta
  readonly routeId: RouteId
  readonly site: Site
  readonly structuredData?: object
}
const { locale, page, routeId, site, structuredData } = Astro.props
const labels = UI[locale]
const title = `${page.title[locale]} | ${site.name[locale]}`
const description = page.summary[locale]
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"} data-js="false">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const root = document.documentElement
        root.dataset.js = "true"
        let theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        let hasThemeOverride = false
        try {
          const storedTheme = window.localStorage.getItem("joeych-theme")
          if (storedTheme === "light" || storedTheme === "dark") {
            theme = storedTheme
            hasThemeOverride = true
          }
        } catch {}
        root.dataset.themeOverride = String(hasThemeOverride)
        root.dataset.theme = theme
        root.style.colorScheme = theme
      })()
    </script>
    {locale === "en" && <Font cssVariable="--font-dm-sans" preload />}
    <Font cssVariable="--font-google-sans-code" preload />
    <SeoHead routeId={routeId} locale={locale} site={site} title={title} description={description} structuredData={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skipToContent}</a>
    <SiteHeader locale={locale} site={site} routeId={routeId} />
    <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
    <SiteFooter locale={locale} site={site} />
  </body>
</html>
