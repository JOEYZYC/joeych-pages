---
import AchievementLedger from "../../../../../src/components/AchievementLedger.astro"
import { awardSchema } from "../../../../../src/content/schemas"

const safeExternalUrl = "https://evidence.example/archive/award-2025"

const baseAward = {
  year: 2025,
  featured: false,
  title: { zh: "测试奖项", en: "Fixture award" },
  prizes: [{ level: "fixture", zh: "测试奖项", en: "Fixture prize" }],
  tags: ["fixture"],
  certificates: [],
} as const

const nullableAward = awardSchema.parse({
  ...baseAward,
  id: "nullable-archive-link",
  links: [{
    type: "archive",
    url: null,
    label: { zh: "来源档案", en: "Source archive" },
  }],
})

const externalAward = awardSchema.parse({
  ...baseAward,
  id: "external-archive-link",
  links: [{
    type: "archive",
    url: safeExternalUrl,
    label: { zh: "来源档案", en: "Source archive" },
  }],
})

const malformedFixture = awardSchema.safeParse({
  ...baseAward,
  id: "malformed-archive-link",
  links: [{
    type: "archive",
    url: "not-a-url",
    label: { zh: "来源档案", en: "Source archive" },
  }],
})
---

<!-- case:zh-null:start -->
<AchievementLedger awards={[nullableAward]} locale="zh" />
<!-- case:zh-null:end -->
<!-- case:en-null:start -->
<AchievementLedger awards={[nullableAward]} locale="en" />
<!-- case:en-null:end -->
<!-- case:en-external:start -->
<AchievementLedger awards={[externalAward]} locale="en" />
<!-- case:en-external:end -->
<!-- case:malformed:start -->
<span>{malformedFixture.success ? "fixture-accepted" : "fixture-rejected"}</span>
<!-- case:malformed:end -->
